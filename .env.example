# Database
POSTGRES_USER=mediashelf
POSTGRES_PASSWORD=mediashelf_dev
POSTGRES_DB=mediashelf
DATABASE_URL=postgresql+asyncpg://mediashelf:mediashelf_dev@db:5432/mediashelf

# Auth
SECRET_KEY=change-me-to-a-random-256-bit-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# External APIs (optional - app works without these)
DISCOGS_TOKEN=
TMDB_API_KEY=
GOOGLE_BOOKS_API_KEY=

# CORS — add your Cloudflare tunnel URL here for production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Web port (production nginx)
WEB_PORT=8080
