# Database
POSTGRES_USER=mediashelf
POSTGRES_PASSWORD=mediashelf_dev
POSTGRES_DB=mediashelf
DATABASE_URL=postgresql+asyncpg://mediashelf:mediashelf_dev@db:5432/mediashelf

# Auth
SECRET_KEY=change-me-to-a-random-256-bit-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Registration gate. Once at least one account exists, /auth/register is refused
# unless this is set AND the request sends a matching invite_code. Empty = closed.
REGISTRATION_INVITE_CODE=

# External APIs (optional - app works without these)
DISCOGS_TOKEN=
TMDB_API_KEY=
GOOGLE_BOOKS_API_KEY=
# Video games — either or both. IGDB: dev.twitch.tv app. RAWG: rawg.io/apidocs
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RAWG_API_KEY=

# AI recommendations via Ollama. Empty OLLAMA_URL = off.
#   Another machine on your LAN (fastest, e.g. a Mac with native Ollama):
#     OLLAMA_URL=http://192.168.4.37:11434
#   The optional in-stack container (CPU only, slow):
#     OLLAMA_URL=http://ollama:11434   + docker compose --profile local-llm up -d
OLLAMA_URL=
OLLAMA_MODEL=gemma3:12b
# Or use Claude instead of Ollama (costs a few cents per run):
#   AI_PROVIDER=claude
AI_PROVIDER=ollama
ANTHROPIC_API_KEY=
# Saved picks older than this many hours are rebuilt (checked hourly; retried if the model is offline)
RECOMMENDATIONS_REFRESH_HOURS=24

# CORS — add your Cloudflare tunnel URL here for production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Web port (production nginx)
WEB_PORT=8080
